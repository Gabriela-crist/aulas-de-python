def fatorial(n, show= False):
    """
    calcula o fatorial de um numero
    n  = numero para calcular
    show = é opcional, mostra ou nao a conta
    return = mostra o fatorial de n
    """
    f = 1 
    for c in range(n,0, -1):
        if show:
            print(c,end="")
            if c > 1:
                print(" x ",end="")
            else:
                print(" =",end="")

        f*=c
    return f


print(fatorial(5, show=True))
