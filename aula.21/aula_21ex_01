from datetime import date
ano = int(input("em que ano vc nasceu ?"))
def voto(data):
 if data >= 18 and data < 70:
  print(f"com {data} anos o voto é obrigatorio! ")
 elif data < 18:
  print(f'com {data} anos nao tem direito ao voto ainda')
 elif data >=  70:
  print(f"com {data} anos seu voto é opcional")

idade= date.today().year - ano
voto(idade)

